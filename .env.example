# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bank sync provider (example: Plaid)
BANK_PROVIDER_DEFAULT=plaid
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US
PLAID_ANDROID_PACKAGE_NAME=com.vault.app
PLAID_REDIRECT_URI=vault://plaid/oauth
PLAID_WEBHOOK_URL=https://<project-ref>.functions.supabase.co/v1/vault-bank-webhook
EXPO_PUBLIC_PLAID_REDIRECT_URI=vault://plaid/oauth
# Set true only for local debugging without signed webhooks.
# PLAID_WEBHOOK_VERIFICATION_DISABLED=false

# AI provider
OPENAI_API_KEY=your-openai-api-key

# App URLs for deep links/referrals
EXPO_PUBLIC_APP_SCHEME=vault
EXPO_PUBLIC_SHARE_BASE_URL=https://vault.app

# Internal worker auth
VAULT_INTERNAL_WORKER_SECRET=long-random-internal-worker-secret

# Optional analytics
# POSTHOG_API_KEY=your-posthog-api-key
